# Required: generate a long random value; never commit the real .env file.
EDUBRIDGE_API_KEY=replace-with-a-long-random-secret

# Comma-separated browser origins. Prefer a server-side frontend proxy.
EDUBRIDGE_CORS_ORIGINS=https://your-frontend.example.com

# Optional: used for AI-generated narrative explanations.
GEMINI_API_KEY=

# Container paths (normally keep these defaults).
CDACDM_ARTIFACT_DIR=/app/artifacts
EEDI_CONTENT_PATH=/app/content/eedi_questions.json
EEDI_IMAGE_DIR=/app/content/images
